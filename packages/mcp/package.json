{
  "name": "@pokedocs/mcp",
  "version": "0.1.0",
  "description": "Optional MCP server for a built PokeDocs site: search and a read-only filesystem over the markdown twins, over stdio or streamable HTTP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wbaxterh/pokedocs.git",
    "directory": "packages/mcp"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0"
  }
}
