import type * as Preset from '@docusaurus/preset-classic';
import type { Config } from '@docusaurus/types';
import type { PokedocsPresetOptions } from '@pokedocs/preset';

// Bound once so the name is escaped in a single place and safe everywhere it
// is reused below, including inside the template literal in the footer.
const siteName = {{SITE_NAME_TS}};
const tagline = {{TAGLINE_TS}};

const config: Config = {
  title: siteName,
  tagline,

  // Overridable per-environment; a production build with a placeholder
  // url warns (POKEDOCS_STRICT_URL=true makes it an error). `||` on
  // purpose: an empty env var must fall back too.
  url: process.env.POKEDOCS_URL || '{{URL}}',
  baseUrl: process.env.POKEDOCS_BASE_URL || '{{BASE_URL}}',

  onBrokenLinks: 'throw',

  // Docusaurus wraps its stylesheet in @layer under v4, which is what lets
  // the preset's branding win the cascade. Removing this makes the compiled
  // brand colors silently lose to Infima's defaults.
  future: {
    v4: true,
  },

  i18n: {
    defaultLocale: 'en',
    locales: ['en'],
  },

  // The landing page (src/pages/index.tsx) renders these cards — edit the
  // config, not the component. Every `to:` must resolve to a real doc route
  // or the build fails.
  customFields: {
    landing: {
      cards: [
        {
          title: 'Get started',
          description: 'Run the site locally and publish your first page.',
          to: '/intro',
        },
        {
          title: 'Authoring',
          description:
            'Frontmatter, sidebars, and diagrams that agents can read.',
          to: '/authoring',
        },
      ],
    },
  },

  presets: [
    [
      '@pokedocs/preset',
      {
        branding: {
          brandColor: '{{BRAND_COLOR}}',
          logo: '{{LOGO_PATH}}',
        },
        docs: {
          sidebarPath: './sidebars.ts',
        },
        // Every page needs a description — agents and search rely on it.
        // This is the contract AGENTS.md documents, enforced by the build.
        frontmatterSchema: {
          schemas: [
            {
              include: '**',
              fields: {
                description: { type: 'string', required: true },
              },
            },
          ],
        },
        theme: {
          customCss: './src/css/custom.css',
        },
      } satisfies PokedocsPresetOptions,
    ],
  ],

  themeConfig: {
    colorMode: {
      respectPrefersColorScheme: true,
    },
    navbar: {
      title: siteName,
      logo: {
        alt: `${siteName} logo`,
        src: '{{LOGO_PATH}}',
      },
    },
    footer: {
      style: 'dark',
      copyright: `Copyright © ${new Date().getFullYear()} ${siteName}`,
    },
  } satisfies Preset.ThemeConfig,
};

export default config;
